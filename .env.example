# ============================================================
# JCAB / Adaptive Assessment - Environment Configuration
# ============================================================
# Copy this file to .env and provide your secret values.
# NEVER commit the real .env file or API keys to version control.

# Google Gemini API Key (Required for 4-agent LLM feedback)
LLM_API_KEY=your_gemini_api_key_here

# LLM Model Name (Default: gemini-3.5-flash-lite)
LLM_MODEL=gemini-3.5-flash-lite

# LLM Provider (Default: gemini)
LLM_PROVIDER=gemini

# Toggle LLM feedback (true to use multi-agent LLM, false for fast deterministic local fallback)
USE_LLM_FEEDBACK=true

# Streamlit Server Port (Default: 8501)
STREAMLIT_SERVER_PORT=8501

# Streamlit Headless Mode
STREAMLIT_SERVER_HEADLESS=true
